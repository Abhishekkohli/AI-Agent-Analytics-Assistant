[Unit]
Description=AI Agent Analytics Assistant API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/analytics-assistant
EnvironmentFile=-/etc/analytics-assistant/env
Environment=PYTHONUNBUFFERED=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/opt/analytics-assistant/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
# Sentence-transformers + Chroma can use several GB on first load
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
